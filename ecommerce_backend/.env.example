# MongoDB connection - use MONGODB_URL and MONGODB_DB
# The database container provides these via db_env_vars: MONGODB_URL, MONGODB_DB
MONGODB_URL=mongodb://appuser:dbuser123@localhost:5001/?authSource=admin
MONGODB_DB=myapp

# Server configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS configuration - frontend on port 3000
ALLOWED_ORIGINS=http://localhost:3000,https://vscode-internal-42646-beta.beta01.cloud.kavia.ai:3000
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_MAX_AGE=3600

# Trust proxy settings
TRUST_PROXY=true

# JWT Authentication - REQUIRED: Set a secure random string for JWT_SECRET
JWT_SECRET=your_secure_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
